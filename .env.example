# HealthScore environment variables. All are optional; the app runs with none set.
#
# DataSF's SODA API works without authentication. Providing a Socrata app token
# only raises the request rate limit, which matters solely if a data refresh
# gets throttled. Register a free token at https://dev.socrata.com/register.
DATASF_APP_TOKEN=

# Port for the local server (default 8000).
PORT=8000
